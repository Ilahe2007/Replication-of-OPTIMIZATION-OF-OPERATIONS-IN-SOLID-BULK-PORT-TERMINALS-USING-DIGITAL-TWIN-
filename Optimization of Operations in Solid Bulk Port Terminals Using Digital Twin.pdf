<</Annots[ 144 0 R  145 0 R  195 0 R  197 0 R  199 0 R  201 0 R  203 0 R  205 0 R  207 0 R  209 0 R ]/Contents 146 0 R /CropBox[ 0 0 612 792]/FastOCRPageData({"json_version":1,"text_blocks":[{"contentSize":{"height":7,"width":42},"id":"40","polygon":[153,92,153,99,195,99,195,92],"scale":2.426712989807129,"text":"ships in queue"},{"contentSize":{"height":7,"width":37},"id":"34","polygon":[156,112,156,119,193,119,193,112],"scale":2.426712989807129,"text":"ships in ETA"},{"contentSize":{"height":7,"width":33},"id":"17","polygon":[183,321,183,327,215,327,215,321],"scale":2.426712989807129,"text":"store best"},{"contentSize":{"height":7,"width":33},"id":"13","polygon":[183,329,183,336,216,336,216,329],"scale":2.426712989807129,"text":"solutionz*"},{"contentSize":{"height":7,"width":33},"id":"7","polygon":[184,364,184,371,217,371,217,364],"scale":2.426712989807129,"text":"missing ships"},{"contentSize":{"height":5,"width":9},"id":"2","polygon":[153,375,153,380,162,380,162,375],"scale":2.426712989807129,"text":"yes"},{"contentSize":{"height":5,"width":35},"id":"4","polygon":[183,371,183,376,218,376,218,371],"scale":2.426712989807129,"text":"without loaded"},{"contentSize":{"height":4,"width":4},"id":"37","polygon":[224,102,224,106,228,106,228,102],"scale":2.426712989807129,"text":"v"},{"contentSize":{"height":3,"width":3},"id":"14","polygon":[227,327,227,330,230,330,230,327],"scale":2.426712989807129,"text":"æ¥"},{"contentSize":{"height":8,"width":81},"id":"39","polygon":[243,96,243,104,324,104,324,96],"scale":2.426712989807129,"text":"Ordered list of ships to be"},{"contentSize":{"height":7,"width":33},"id":"36","polygon":[267,104,267,111,300,111,300,104],"scale":2.426712989807129,"text":"scheduled"},{"contentSize":{"height":7,"width":100},"id":"30","polygon":[234,176,234,183,334,183,334,176],"scale":2.426712989807129,"text":"Select the next ship from the list that"},{"contentSize":{"height":7,"width":108},"id":"28","polygon":[230,184,230,191,338,191,338,184],"scale":2.426712989807129,"text":"has enough cargo for loading \(avaliable"},{"contentSize":{"height":7,"width":76},"id":"26","polygon":[246,191,246,198,322,198,322,191],"scale":2.426712989807129,"text":"in the yard and train queue\)"},{"contentSize":{"height":5,"width":96},"id":"24","polygon":[237,215,237,220,334,220,334,215],"scale":2.426712989807129,"text":"Search for stacks and trains for"},{"contentSize":{"height":5,"width":23},"id":"22","polygon":[274,223,274,229,296,229,296,223],"scale":2.426712989807129,"text":"sevice"},{"contentSize":{"height":7,"width":98},"id":"21","polygon":[235,251,235,259,334,258,334,250],"scale":2.426712989807129,"text":"Build schedules for routes, stacks"},{"contentSize":{"height":5,"width":79},"id":"20","polygon":[245,260,245,265,324,265,324,260],"scale":2.426712989807129,"text":"and trains for each solution"},{"contentSize":{"height":5,"width":101},"id":"19","polygon":[233,288,233,294,335,294,335,288],"scale":2.426712989807129,"text":"Estimate the current objective function z"},{"contentSize":{"height":7,"width":33},"id":"18","polygon":[267,294,267,301,300,301,300,294],"scale":2.426712989807129,"text":"\(queuetime\)"},{"contentSize":{"height":5,"width":16},"id":"15","polygon":[276,326,276,331,292,331,292,326],"scale":2.426712989807129,"text":"Z<Z*"},{"contentSize":{"height":6,"width":9},"id":"11","polygon":[233,332,233,338,242,338,242,332],"scale":2.426712989807129,"text":"yes"},{"contentSize":{"height":5,"width":7},"id":"3","polygon":[243,375,243,379,250,379,250,375],"scale":2.426712989807129,"text":"no"},{"contentSize":{"height":7,"width":38},"id":"6","polygon":[265,367,265,374,303,374,303,367],"scale":2.426712989807129,"text":"output: bestz*"},{"contentSize":{"height":5,"width":7},"id":"10","polygon":[329,334,329,338,336,338,336,334],"scale":2.426712989807129,"text":"ou"},{"contentSize":{"height":7,"width":84},"id":"38","polygon":[366,96,366,103,450,103,450,96],"scale":2.426712989807129,"text":"Swap ships positions in the"},{"contentSize":{"height":7,"width":56},"id":"35","polygon":[380,105,380,112,436,112,436,105],"scale":2.426712989807129,"text":"queue \(by-pass**\)"},{"contentSize":{"height":5,"width":5},"id":"33","polygon":[406,116,406,121,411,121,411,116],"scale":2.426712989807129,"text":"æœ¬"},{"contentSize":{"height":8,"width":89},"id":"32","polygon":[363,137,363,145,452,145,452,137],"scale":2.426712989807129,"text":"Update objective function: z*"},{"contentSize":{"height":4,"width":34},"id":"31","polygon":[390,146,390,151,424,150,424,146],"scale":2.426712989807129,"text":"1*1"},{"contentSize":{"height":7,"width":85},"id":"29","polygon":[364,179,364,186,449,186,449,179],"scale":2.426712989807129,"text":"Feasible ship scheduling with"},{"contentSize":{"height":8,"width":57},"id":"27","polygon":[378,187,378,195,435,195,435,187],"scale":2.426712989807129,"text":"objective function z"},{"contentSize":{"height":7,"width":73},"id":"25","polygon":[371,213,371,220,444,220,444,213],"scale":2.426712989807129,"text":"Ants explore alternative"},{"contentSize":{"height":6,"width":55},"id":"23","polygon":[381,222,381,228,435,228,435,222],"scale":2.426712989807129,"text":"routes and stacks"},{"contentSize":{"height":7,"width":23},"id":"16","polygon":[359,321,359,327,383,327,383,321],"scale":2.426712989807129,"text":"solution"},{"contentSize":{"height":7,"width":40},"id":"12","polygon":[351,329,351,336,392,336,392,329],"scale":2.426712989807129,"text":"discarded/cut"},{"contentSize":{"height":5,"width":30},"id":"9","polygon":[434,354,434,358,463,358,463,354],"scale":2.426712989807129,"text":"**BYPA.SS"},{"contentSize":{"height":5,"width":89},"id":"8","polygon":[375,362,375,367,464,367,464,362],"scale":2.426712989807129,"text":"although uncommon in practice \(as it affects"},{"contentSize":{"height":5,"width":98},"id":"5","polygon":[365,369,365,375,464,375,464,369],"scale":2.426712989807129,"text":"contractual commintments\) the proposed method"},{"contentSize":{"height":5,"width":105},"id":"1","polygon":[358,376,358,382,464,382,464,376],"scale":2.426712989807129,"text":"can execute a \\"by-pass\\" of ships. meaning a chanqe"},{"contentSize":{"height":5,"width":93},"id":"0","polygon":[371,384,371,389,464,389,464,384],"scale":2.426712989807129,"text":"in the order of service \(violating the FIFO rule\)"}]})/FastOCRPageID(9FB561387998FB6B635BD4CB9DE25B27)/Group 28 0 R /MediaBox[ 0 0 612 792]/Parent 9 0 R /QITE_pageid<</D(D:20251103102717)/F 29 0 R /I 30 0 R /P 6/UF 31 0 R >>/Resources<</ExtGState<</GS1 147 0 R >>/Font<</F1 33 0 R /F69 34 0 R /F70 35 0 R /F71 36 0 R >>/ProcSet[/PDF/Text/ImageC/ImageB/ImageI]/XObject<</Im2 148 0 R >>>>/Rotate 0/Type/Page>>
